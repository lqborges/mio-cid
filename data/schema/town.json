{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mio-cid/town",
  "title": "TownHolding",
  "type": "object",
  "required": [
    "id",
    "alfonso_protectorate",
    "keep_or_sell",
    "keep_past_deadline_fail",
    "sell_deadline_days",
    "booty"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "display_name_key": { "type": "string" },
    "beat": { "type": "string" },
    "alfonso_protectorate": { "type": "boolean" },
    "keep_or_sell": { "type": "boolean" },
    "keep_past_deadline_fail": { "type": "boolean" },
    "sell_deadline_days": { "type": "integer", "minimum": 0 },
    "booty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "marks": { "type": "integer", "minimum": 0 },
        "horses": { "type": "integer", "minimum": 0 },
        "cloth": { "type": "integer", "minimum": 0 },
        "arms": { "type": "integer", "minimum": 0 }
      }
    },
    "take_event_id": { "type": "string" },
    "sell_event_id": { "type": "string" },
    "keep_event_id": { "type": "string" }
  }
}
