{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mio-cid/weapon_moveset",
  "title": "WeaponMoveset",
  "type": "object",
  "required": ["id", "max_combo", "combo", "slash", "thrust", "shield_bash"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "max_combo": { "type": "integer", "minimum": 1, "maximum": 3 },
    "combo": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "enum": ["slash", "thrust", "bash"] }
    },
    "slash": { "$ref": "#/$defs/move" },
    "thrust": { "$ref": "#/$defs/move" },
    "shield_bash": { "$ref": "#/$defs/move" },
    "leap": { "$ref": "#/$defs/move" },
    "shout": { "$ref": "#/$defs/move" },
    "lance_couch": { "$ref": "#/$defs/move" },
    "dismount_hook": { "$ref": "#/$defs/move" }
  },
  "$defs": {
    "move": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "damage": { "type": "number" },
        "stamina": { "type": "number" },
        "duration": { "type": "number" },
        "stagger": { "type": "number" },
        "radius": { "type": "number" }
      }
    }
  }
}
