  "properties": {
    "id": { "type": "string", "enum": ["infanzon", "mesura", "campeador"] },
    "hp_regen_camp_night": { "type": "number" },
    "hp_regen_beat_start": { "type": "number" },
    "stamina_regen": { "type": "number" },
    "incoming": { "type": "number" },
    "parry_window_ms": { "type": "number" },
    "meter_sinks": { "type": "number" }
  }
}
