{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mio-cid/chapter_graph",
  "title": "ChapterGraph",
  "description": "Campaign beat graph. Scene paths may point at missing tscn until later PRs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scene", "act"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^a[123]_[a-z0-9_]+$"
          },
          "scene": { "type": "string", "minLength": 1 },
          "act": { "type": "integer", "minimum": 1, "maximum": 3 },
          "reorderable": { "type": "boolean", "default": false },
          "v1_cut": { "type": "boolean", "default": false }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "req_flags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "forbid_flags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "set_flags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
