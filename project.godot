; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mio Cid"
config/description="Third-person action-RPG campaign of the Cantar de Mio Cid."
config/version="0.0.0"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://game/autoload/event_bus.gd"
HonorService="*res://game/autoload/honor_service.gd"
SaveService="*res://game/autoload/save_service.gd"
ChapterRunner="*res://game/autoload/chapter_runner.gd"
CampaignClock="*res://game/autoload/campaign_clock.gd"
TreasuryService="*res://game/autoload/treasury_service.gd"
GameState="*res://game/autoload/game_state.gd"
Loc="*res://game/autoload/loc.gd"

[internationalization]

locale/fallback="es"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
