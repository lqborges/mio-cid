[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="hurtbox_killable"
3d_physics/layer_4="lance_wedge"
3d_physics/layer_5="street_melee"
3d_physics/layer_6="unkillable"
3d_physics/layer_7="spectator"
3d_physics/layer_8="horse"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d.mobile=1
anti_aliasing/quality/screen_space_aa.mobile=1
; Default GL Compatibility so Intel HD 4000 (Envy) boots on Win10.
; Laptop (Iris Xe): --rendering-method forward_plus --rendering-driver vulkan
; Android: canvas_items + 2x MSAA + FXAA so 3D is native, not a 720p stretch.
