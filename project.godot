; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mio Cid"
config/description="Isometric action-RPG campaign of the Cantar de Mio Cid."
config/version="0.0.0"
run/main_scene="res://game/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

EventBus="*res://game/autoload/event_bus.gd"
HonorService="*res://game/autoload/honor_service.gd"
SaveService="*res://game/autoload/save_service.gd"
ChapterRunner="*res://game/autoload/chapter_runner.gd"
CampaignClock="*res://game/autoload/campaign_clock.gd"
TreasuryService="*res://game/autoload/treasury_service.gd"
GameState="*res://game/autoload/game_state.gd"
Loc="*res://game/autoload/loc.gd"
MobileLook="*res://game/autoload/mobile_look.gd"
HumanoidLooks="*res://game/autoload/humanoid_looks.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
PlayerGuide="*res://game/autoload/player_guide.gd"
PauseMenu="*res://game/ui/pause_menu.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/mode.mobile="canvas_items"
window/stretch/aspect="keep"
window/stretch/aspect.mobile="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

